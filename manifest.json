{
  "manifest_version": 3,
  "name": "DLP Guard — Secret Detector & Hider",
  "version": "0.1.0",
  "description": "Hides secrets, API keys, and tokens on web pages and redacts pastes. 100% local. Never runs on login or registration pages.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DLP Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "src/patterns.generated.js",
        "src/patterns.extra.js",
        "src/engine.js",
        "src/pageguard.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
